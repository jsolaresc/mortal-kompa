<?xml version="1.0" encoding="utf-8"?>
<!-- Versión Google TV: se agrega a la de siempre (src/main). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- en la tele no hay pantalla táctil (se juega con joystick o control remoto) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application android:banner="@drawable/tv_banner">
        <!-- la pantalla de celular no se usa: la reemplaza TvActivity -->
        <activity android:name=".MainActivity" tools:node="remove" />

        <activity
            android:name=".TvActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- aparece en el inicio de Google TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
